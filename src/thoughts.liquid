---
layout: default.liquid
---

<div class="content-header">
  <h1>Thoughts</h1>
  <hr class="separator">
</div>

<div class="post-collection">
  {% for post in collections.thoughts reversed %}
    <a href="{{ post.url }}" class="post-row">
      
      <div class="post-row-meta">
        <time datetime="{{ post.date | date: '%Y-%m-%d' }}">
          {{ post.date | date: "%b %d, %Y" }}
        </time>
        <span class="read-time">{{ post.templateContent | readTime }}</span>
      </div>

      <div class="post-row-content">
        
        <div class="post-title-line">
          <h2 class="post-preview-title">{{ post.data.title }}</h2>
          
          {% if post.data.tags %}
            <div class="tag-list">
              {% for tag in post.data.tags %}
                {% if tag != "thoughts" %}
                  <span class="post-tag">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
        
        {% if post.data.subtitle %}
          <p class="post-preview-subtitle">{{ post.data.subtitle }}</p>
        {% endif %}
        
      </div>
    </a>
  {% endfor %}
</div>
