{% assign meta_title = title | default: "mkf.dev" %}
{% assign meta_desc = subtitle | default: "A collection of ideas, projects, and works in progress." %}
{% assign current_url = "https://mkf.dev" | append: page.url %}

<meta name="description" content="{{ meta_desc }}" />
<meta property="og:title" content="{{ meta_title }}" />
<meta property="og:description" content="{{ meta_desc }}" />
<meta property="og:url" content="{{ current_url }}" />

<meta name="twitter:title" content="{{ meta_title }}" />
<meta name="twitter:description" content="{{ meta_desc }}" />

{% if image %}
  {% capture optimized_path %}{% ogImage image %}{% endcapture %}
  {% assign absoluteImageUrl = "https://mkf.dev" | append: optimized_path %}

  <meta property="og:type" content="article" />
  <meta property="og:image" content="{{ absoluteImageUrl }}" />
  <meta property="og:image:alt" content="{{ imageAlt | default: meta_title }}" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="{{ absoluteImageUrl }}" />
  <meta name="twitter:image:alt" content="{{ imageAlt | default: meta_title }}" />
{% else %}
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
{% endif %}

{% if page.date %}
  <meta property="article:published_time" content="{{ page.date | date: '%Y-%m-%d' }}" />
{% endif %}

{% if tags %}
  {% for tag in tags %}
    <meta property="article:tag" content="{{ tag }}" />
  {% endfor %}
{% endif %}
