<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>{{ title | default: "MKF" }}</title>

    <!-- EMBED METADATA -->

    {% if image %}
      {% capture optimized_path %}{% ogImage image %}{% endcapture %}
      {% assign absoluteImageUrl = "https://mkf.dev" | append: optimized_path %}

      <meta property="og:type" content="article" />
      <meta property="og:image" content="{{ absoluteImageUrl }}" />
      <meta property="og:image:alt" content="{{ imageAlt }}" />
      
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content="{{ absoluteImageUrl }}" />
      <meta name="twitter:image:alt" content="{{ imageAlt }}" />
    {% endif %}

    {% if subtitle %}
      <meta name="description" content="{{ subtitle }}" />
      <meta property="og:description" content="{{ subtitle }}" />
      <meta name="twitter:description" content="{{ subtitle }}" />
    {% endif %}

    {% if page.date %}
      <meta property="article:published_time" content="{{ page.date | date: '%Y-%m-%d' }}" />
    {% endif %}

    {% if tags %}
      {% for tag in tags %}
        <meta property="article:tag" content="{{ tag }}" />
      {% endfor %}
    {% endif %}

    <!-- MANIFEST -->
    <link rel="manifest" href="/site.webmanifest">

    <!-- ICONS -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">


    <!-- STYLES -->
    <link rel="stylesheet" href="/sanitize.css">
    <link rel="stylesheet" href="/styles.css">
    <link rel="alternate" type="application/atom+xml" title="Thoughts RSS Feed" href="/thoughts/feed.xml" />


    <!-- SCRIPTS -->
    <script src="https://kit.fontawesome.com/9d4a9ac1cf.js" crossorigin="anonymous"></script>
    <script src="/thoughts-observer.js"></script>
    <script src="/random-footer.js" defer></script>
  </head>
  <body>
    <header>
      <div>
        <a id="logo" href="/">MKF</a>
      </div>
      <div id="header-links">
        <a href="https://github.com/MorganKF" aria-label="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
        <a href="https://morganf.itch.io/" aria-label="itch.io"><i class="fa-brands fa-itch-io" aria-hidden="true"></i></a>
        <a href="/thoughts/feed.xml" aria-label="RSS Feed"><i class="fa-light fa-square-rss" aria-hidden="true"></i></a>
      </div>
    </header>
    
    <nav id="nav" aria-label="Primary Navigation">
      <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a>
      <a href="/thoughts/" {% if page.url contains '/thoughts' %}aria-current="page"{% endif %}>Thoughts</a>

      {% include "sidebar.liquid" %}
    </nav>
    
    <main id="main-content" class="content">
      {{content}}
    </main>
    
    <footer class="site-footer">
      <p><span id="random-phrase">Bottom Text</span> &middot; <a id="source-link" href="https://github.com/MorganKF/mkf">source</a></p>
    </footer>
  </body>
</html>
